# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI (OpenRouter using Google Gemini 3.1 Flash Lite)
OPENROUTER_API_KEY=sk-or-v1-...
AI_MODEL=google/gemini-3.1-flash-lite

# Resend (email sending)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@monad.app

# Postmark (inbound email)
# Include this token in the inbound webhook URL, for example:
# ${NEXT_PUBLIC_APP_URL}/api/webhooks/email?token=${POSTMARK_INBOUND_WEBHOOK_TOKEN}
POSTMARK_INBOUND_WEBHOOK_TOKEN=your-webhook-token

# GitHub App
# Setup URL: ${NEXT_PUBLIC_APP_URL}/api/github/setup
# Callback URL: ${NEXT_PUBLIC_APP_URL}/api/github/auth/callback
# Webhook URL: ${NEXT_PUBLIC_APP_URL}/api/webhooks/github
# Repository permissions: issues:write, metadata:read, pull_requests:read
# Webhook events: pull_request, issues, installation, installation_repositories
GITHUB_APP_ID=1234567
GITHUB_APP_CLIENT_ID=Iv1.your-client-id
GITHUB_APP_CLIENT_SECRET=your-client-secret
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
INBOUND_EMAIL_DOMAIN=inbound.monad.app

# Set to true to skip AI calls during dev
MOCK_AI=false
