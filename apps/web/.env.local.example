# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI (OpenRouter primary, OpenAI fallback)
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=sk-...

# Resend (email sending)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@monad.app

# Postmark (inbound email)
POSTMARK_INBOUND_WEBHOOK_TOKEN=your-webhook-token
POSTMARK_SERVER_TOKEN=your-server-token

# GitHub OAuth App
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
INBOUND_EMAIL_DOMAIN=inbound.monad.app

# Set to true to skip OpenAI calls during dev
MOCK_AI=false
